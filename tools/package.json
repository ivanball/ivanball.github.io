{
  "name": "mmca-website-docs-builder",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Renders the MMCA ADRs and Onboarding guide into static HTML pages for the site. Run: npm install && npm run build",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node build-docs.mjs",
    "images": "node build-images.mjs",
    "og-image": "node build-og-image.mjs",
    "a11y": "node a11y-check.mjs",
    "resume-pdf": "node build-resume-pdf.mjs"
  },
  "dependencies": {
    "marked": "^15.0.0",
    "minisearch": "^7.2.0"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "axe-core": "^4.12.1",
    "highlight.js": "^11.11.1",
    "mermaid": "^11.0.0",
    "puppeteer": "^25.3.0",
    "sharp": "^0.35.3"
  }
}
